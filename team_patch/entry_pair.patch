+  std::optional<double> yellow_pair_lean(const cv::Mat & yellow, int y_end)
+  {
+    const int mid = static_cast<int>(bev_center_x_ * yellow.cols);
+    const std::optional<Line> left = fit_line(yellow, 0, mid, y_end);
